{
  "mcpServers": {
    "pqmp-requirements": {
      "command": "node",
      "args": ["tools/pqmp-mcp/src/server.js"]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c", "npx", "-y", "@playwright/mcp@0.0.83",
        "--user-data-dir", ".playwright-profile",
        "--output-dir", "analysis/portal/raw",
        "--viewport-size", "1440x900"
      ]
    },
    "mobile": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@mobilenext/mobile-mcp@1.0.14"]
    }
  }
}
